.venv/
.tfjsenv/
node_modules/
Logs/

# สร้างใหม่ได้ด้วย npm run build:deploy
deploy/

# tfjs_build เป็นของที่ build ได้ใหม่ จึงไม่ track
# ยกเว้นโมเดลที่หน้าเว็บต้องใช้จริง — ถ้า ignore ทั้งก้อน คนที่ clone ไปจะ
# deploy ไม่ได้จนกว่าจะเทรนใหม่ทั้งหมด (เทรนใช้เวลาและต้องมีข้อมูลดิบครบ)
tfjs_build/*
!tfjs_build/pose_action/
tfjs_build/pose_action/*
!tfjs_build/pose_action/meta.json
!tfjs_build/pose_action/model/

# โมเดล MediaPipe ~15MB โหลดใหม่ได้จาก storage.googleapis.com
# ไม่ควรอยู่ใน git — ดู web/README.md สำหรับ URL
web/models/*.task
