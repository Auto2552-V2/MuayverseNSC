# This .gitignore is placed at the root of the Git repo (TICTA/)
# The actual Unity project lives inside Unity_Game/, so all root-anchored
# rules below are prefixed with /Unity_Game/ to match correctly.
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
.utmp/
/Unity_Game/[Ll]ibrary/
/Unity_Game/[Tt]emp/
/Unity_Game/[Oo]bj/
/Unity_Game/[Bb]uild/
/Unity_Game/[Bb]uilds/
/Unity_Game/[Ll]ogs/
/Unity_Game/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/Unity_Game/[Mm]emoryCaptures/

# Recordings can get excessive in size
/Unity_Game/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /Unity_Game/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/Unity_Game/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/Unity_Game/ServerData
/Unity_Game/[Aa]ssets/StreamingAssets/aa*
/Unity_Game/[Aa]ssets/AddressableAssetsData/link.xml*
/Unity_Game/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Unity_Game/Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/Unity_Game/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/Unity_Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/Unity_Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/Unity_Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/Unity_Game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/Unity_Game/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Auto-generated cache in Assets folder
/Unity_Game/[Aa]ssets/[Ss]ceneDependencyCache*